# Copie este arquivo para .env e preencha. O .env fica só no seu computador.

# Chave do OmniRoute (Dashboard do OmniRoute > Endpoints)
OMNIROUTE_KEY=

# Conexão com o Origo OS (copie as duas linhas de Origo OS > Configurações > Integrações > Origo Squad)
ORIGO_OS_URL=
ORIGO_OS_TOKEN=


# Porta do painel do squad (padrão 4321)
# PORTA=4321
