# Supabase (Settings > API no painel do Supabase)
SUPABASE_URL=https://xxxx.supabase.co
# Secret key nova (sb_secret_...), em Settings > API Keys. Tem prioridade sobre SUPABASE_SERVICE_ROLE_KEY.
SUPABASE_SECRET_KEY=

# Login do Origo OS
ORIGO_PASSWORD=
ORIGO_SESSION_SECRET=

# Asaas (opcional): cobrança por Pix/boleto com baixa automática
# Chave em Integrações > Chaves de API. Chave de testes começa com $aact_hmlg_.
ASAAS_API_KEY=
# Senha que você inventa e coloca também no webhook do Asaas (URL: https://SEU-SITE/api/asaas)
ASAAS_WEBHOOK_TOKEN=

# Google Agenda (opcional): passo a passo em Configurações > Integrações
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Jeito simples: "Endereço secreto no formato iCal" da sua agenda (Google Agenda > Configurações > Integrar agenda). Só leitura.
GOOGLE_AGENDA_ICS=
